[user]
	name = yahiaklk
	email = yahia.khallouk@gmail.com
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIH1fi2+Q6MGe7TSVH6cQW4ECwBRlzCT1HSn0TlBJVB5b

[core]
	editor = nvim
	excludesfile = ~/.gitignore_global

[gpg]
	format = ssh

[gpg "ssh"]
	program = /opt/1Password/op-ssh-sign
	allowedSignersFile = ~/.config/git/allowed_signers

[commit]
	gpgsign = true

[tag]
	gpgsign = true


[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	autoSetupRemote = true
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential

# Per-machine overrides (e.g. disabling gpgsign where the 1Password
# desktop app isn't set up). Not tracked by this repo; install.sh
# never touches it, so it survives reruns.
[include]
	path = ~/.gitconfig.local
