[user]
	name = yahiaklk
	email = yahia.khallouk@gmail.com
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIO/bhhZmCNH2GB5K62gPV8Nc9V28Ijl24filxqYRJT5L

[core]
	editor = nvim
	excludesfile = ~/.gitignore_global

[gpg]
	format = ssh

[gpg "ssh"]
	program = /opt/1Password/op-ssh-sign

[commit]
	gpgsign = true

[tag]
	gpgsign = true


[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	autoSetupRemote = true
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
