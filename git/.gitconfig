[user]
	name = yahiaklk
	email = yahia.khallouk@gmail.com

[core]
	editor = nvim
	excludesfile = ~/.gitignore_global

# Commit signing is off (2026-11-18): signing through the 1Password agent needs
# the owner at the machine, and unattended commits were failing. Older commits
# are SSH-signed; the settings below still let `git log --show-signature`
# verify them.
[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	autoSetupRemote = true
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential

# Conventional Commits and <type>/<kebab> branch names, enforced by the hooks in
# git/hooks/ (linked to ~/.config/git/hooks), for repositories under ~/projects/
# only. Elsewhere (e.g. the Obsidian vault's auto-sync cron) nothing changes.
[includeIf "gitdir:~/projects/"]
	path = ~/.config/git/projects.gitconfig

# Per-machine overrides (e.g. turning signing back on for one machine).
# Not tracked by this repo; install.sh
# never touches it, so it survives reruns.
[include]
	path = ~/.gitconfig.local
